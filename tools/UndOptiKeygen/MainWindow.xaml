<Window x:Class="UndOptiKeygen.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UndOpti Key Generator" Width="520" Height="470" WindowStartupLocation="CenterScreen"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="UndOpti Key Generator" FontSize="28" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Role" Margin="0,24,0,6"/><ComboBox x:Name="RoleBox" SelectedIndex="0"><ComboBoxItem>OWNER</ComboBoxItem><ComboBoxItem>ADMIN</ComboBoxItem><ComboBoxItem>HELPER</ComboBoxItem><ComboBoxItem>USER</ComboBoxItem></ComboBox><TextBlock Grid.Row="2" Text="Plan" Margin="0,18,0,6"/><ComboBox x:Name="PlanBox" SelectedIndex="4"><ComboBoxItem>1D</ComboBoxItem><ComboBoxItem>7D</ComboBoxItem><ComboBoxItem>30D</ComboBoxItem><ComboBoxItem>1Y</ComboBoxItem><ComboBoxItem>LIFETIME</ComboBoxItem></ComboBox><TextBlock Grid.Row="3" Text="HWID (optional)" Margin="0,18,0,6"/><TextBox x:Name="HwidBox"/><TextBox Grid.Row="4" x:Name="OutputBox" Margin="0,22,0,10" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/><Button Grid.Row="5" Content="GENERATE KEY" Click="Generate_Click" Height="44" FontWeight="Bold"/></Grid></Window>
