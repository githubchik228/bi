<Window
    x:Class="UndOptiKeygen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UndOpti Keygen"
    Width="620"
    Height="520"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="UndOpti Keygen"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,24"/>
        <TextBlock
            Grid.Row="1"
            Text="Role"
            Margin="0,0,0,5"/>
        <ComboBox
            x:Name="RoleBox"
            Grid.Row="1"
            Margin="70,0,0,12"
            SelectedIndex="0">
            <ComboBoxItem Content="USER"/>
            <ComboBoxItem Content="HELPER"/>
            <ComboBoxItem Content="ADMIN"/>
            <ComboBoxItem Content="OWNER"/>
        </ComboBox>
        <TextBlock
            Grid.Row="2"
            Text="Plan"
            Margin="0,0,0,5"/>
        <ComboBox
            x:Name="PlanBox"
            Grid.Row="2"
            Margin="70,0,0,12"
            SelectedIndex="2">
            <ComboBoxItem Content="1 day"/>
            <ComboBoxItem Content="7 days"/>
            <ComboBoxItem Content="30 days"/>
            <ComboBoxItem Content="1 year"/>
            <ComboBoxItem Content="Lifetime"/>
        </ComboBox>
        <TextBlock
            Grid.Row="3"
            Text="HWID"
            Margin="0,0,0,5"/>
        <TextBox
            x:Name="HwidBox"
            Grid.Row="3"
            Margin="70,0,0,12"/>
        <Button
            x:Name="GenerateButton"
            Grid.Row="4"
            Content="GENERATE LICENSE"
            Height="42"
            Click="GenerateButton_Click"
            Margin="0,8,0,18"/>
        <TextBlock
            Grid.Row="5"
            Text="Generated key"
            Margin="0,0,0,5"/>
        <TextBox
            x:Name="KeyBox"
            Grid.Row="5"
            Margin="110,0,0,12"
            IsReadOnly="True"/>
        <TextBox
            x:Name="StatusBox"
            Grid.Row="6"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
