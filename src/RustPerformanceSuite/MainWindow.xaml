<Window x:Class="RustPerformanceSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UndOpti" Width="1400" Height="900" Background="#090C12">
<Window.Resources><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111722"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="5"/></Style><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#1A2230"/><Setter Property="Foreground" Value="White"/></Style></Window.Resources>
<Grid Margin="15"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0F141D" Padding="12"><StackPanel><TextBlock Text="UNDOPTI" Foreground="White" FontSize="25" FontWeight="Bold"/><Button Content="Optimize All" Click="OptimizeAll_Click"/><Button Content="Rust Optimizer" Click="Rust_Click"/><Button Content="Cleaner" Click="Cleaner_Click"/><Button Content="Network" Click="Network_Click"/><Button Content="Power" Click="Power_Click"/><Button Content="Hardware" Click="Hardware_Click"/><Button Content="Rust Priority" Click="RustPriority_Click"/><Button Content="Network Test" Click="NetworkTest_Click"/><Button Content="Shader Cache" Click="Shader_Click"/><Button Content="Startup Report" Click="Startup_Click"/><Button Content="Restore Power" Click="RestorePower_Click"/><Button Content="Restore All" Click="Restore_Click"/><Button Content="Refresh" Click="Refresh_Click"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="15,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="UndOpti" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="READY" DockPanel.Dock="Right" Foreground="#6EE7A8"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,15"><Border Style="{StaticResource Card}"><TextBlock x:Name="CpuText" Text="CPU" Foreground="White"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="RamText" Text="RAM" Foreground="White"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="GpuText" Text="GPU" Foreground="White"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="RustText" Text="RUST" Foreground="White"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="ChangesText" Text="CHANGES 0" Foreground="White"/></Border></UniformGrid>
<ScrollViewer Grid.Row="2"><StackPanel><TextBlock Text="Hardware / BIOS Advisor" Foreground="White" FontSize="20"/><TextBox x:Name="HardwareReport" Height="180" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Recommendations" Foreground="White" FontSize="20" Margin="0,12,0,0"/><TextBox x:Name="RecommendationsText" Height="110" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Diagnostics" Foreground="White" FontSize="20" Margin="0,12,0,0"/><TextBox x:Name="DiagnosticsText" Height="150" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="Activity" Foreground="White" FontSize="20" Margin="0,12,0,0"/><TextBlock x:Name="OperationStatus" Text="Ready. No license or key is required." Foreground="#AEB7C8" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></Grid>
</Window>