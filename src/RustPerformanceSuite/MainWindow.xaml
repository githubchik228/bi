<Window x:Class="RustPerformanceSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UndOpti — Game Performance Optimizer" Width="1200" Height="760" WindowStartupLocation="CenterScreen" Background="#0B0D12">
<Window.Resources><Style x:Key="NavText" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEB7C8"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="4,8"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,6,8,6"/></Style></Window.Resources>
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#121620" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="UNDOPTI" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,4"/><TextBlock Text="Optimize. Measure. Perform." Foreground="#687184" FontSize="11" Margin="0,0,0,24"/><TextBlock Text="Dashboard" Style="{StaticResource NavText}"/><TextBlock Text="AI Assistant" Style="{StaticResource NavText}"/><TextBlock Text="Optimizer" Style="{StaticResource NavText}"/><TextBlock Text="Rust Profiles" Style="{StaticResource NavText}"/><TextBlock Text="Benchmark" Style="{StaticResource NavText}"/><TextBlock Text="Monitor" Style="{StaticResource NavText}"/><TextBlock Text="Backup &amp; Restore" Style="{StaticResource NavText}"/><TextBlock Text="Cleaner" Style="{StaticResource NavText}"/><TextBlock Text="Tools" Style="{StaticResource NavText}"/><TextBlock Text="License" Style="{StaticResource NavText}"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="24,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="UndOpti" Foreground="White" FontSize="30" FontWeight="Bold"/><TextBlock Text="Advanced Game Performance Optimizer" Foreground="#8D96A8" FontSize="14" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="LicenseStatus" DockPanel.Dock="Right" Text="● LICENSE REQUIRED" Foreground="#FFB45C" FontWeight="SemiBold"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,26,0,20"><Border Background="#121620" CornerRadius="12" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="PROCESS CPU" Foreground="#8D96A8"/><TextBlock x:Name="CpuText" Text="—" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="Live monitor" Foreground="#687184"/></StackPanel></Border><Border Background="#121620" CornerRadius="12" Margin="10,0" Padding="18"><StackPanel><TextBlock Text="RAM" Foreground="#8D96A8"/><TextBlock x:Name="RamText" Text="—" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="System usage" Foreground="#687184"/></StackPanel></Border><Border Background="#121620" CornerRadius="12" Margin="10,0" Padding="18"><StackPanel><TextBlock Text="RUST" Foreground="#8D96A8"/><TextBlock x:Name="RustText" Text="Not detected" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Installation / process" Foreground="#687184"/></StackPanel></Border><Border Background="#121620" CornerRadius="12" Margin="10,0,0,0" Padding="18"><StackPanel><TextBlock Text="TWEAKS" Foreground="#8D96A8"/><TextBlock x:Name="TweaksText" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="Reversible" Foreground="#687184"/></StackPanel></Border></UniformGrid>
<Border Grid.Row="2" Background="#121620" CornerRadius="14" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="UndOpti Optimization" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Only changes made by UndOpti are tracked for rollback." Foreground="#8D96A8" Margin="0,8,0,20"/><StackPanel Orientation="Horizontal"><Button Content="OPTIMIZE RUST" Click="Optimize_Click" Background="#2D7DFF" Foreground="White" BorderThickness="0" FontWeight="Bold"/><Button Content="RESTORE CHANGES" Click="Restore_Click"/><Button Content="REFRESH" Click="Refresh_Click"/></StackPanel><TextBlock x:Name="OperationStatus" Text="Ready." Foreground="#AEB7C8" Margin="0,8,0,20"/><Separator Margin="0,8,0,18"/><TextBlock Text="License activation" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBox x:Name="LicenseEndpoint" Text="http://localhost:5000" Margin="0,8,0,6" Height="34"/><TextBox x:Name="LicenseKey" Text="" Margin="0,0,0,6" Height="34"/><StackPanel Orientation="Horizontal"><Button Content="ACTIVATE LICENSE" Click="Activate_Click"/><TextBlock x:Name="HardwareIdText" Foreground="#687184" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Plans: 1d / 7d / 30d / 1y / lifetime." Foreground="#687184" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border></Grid></Grid></Window>