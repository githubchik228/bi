<Window x:Class="RustPerformanceSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UndOpti — PC Performance Suite" Width="1400" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#090C12">
<Window.Resources>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111722"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#1A2230"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,6,8,6"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2D7DFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
<Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#8D98AA"/><Setter Property="FontSize" Value="13"/></Style>
</Window.Resources>
<Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0F141D" CornerRadius="16" Padding="18"><StackPanel>
<TextBlock Text="UNDOPTI" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="PC PERFORMANCE SUITE" Style="{StaticResource Muted}" Margin="0,3,0,25"/>
<TextBlock Text="CONTROL CENTER" Foreground="#4D92FF" FontWeight="Bold" Margin="0,0,0,10"/>
<Button Content="⚡  Optimize All" Click="OptimizeAll_Click"/>
<Button Content="🎮  Rust Optimizer" Click="Rust_Click"/>
<Button Content="🧹  Cleaner" Click="Cleaner_Click"/>
<Button Content="🌐  Network" Click="Network_Click"/>
<Button Content="⚙  Power" Click="Power_Click"/>
<Button Content="🔧  Hardware / BIOS" Click="Hardware_Click"/>
<Button Content="📊  Monitor" Click="Refresh_Click"/>
<Separator Margin="0,16"/>
<TextBlock Text="SAFETY" Foreground="#4D92FF" FontWeight="Bold" Margin="0,0,0,8"/>
<TextBlock Text="All reversible changes are tracked. OC/undervolt values are analyzed per hardware instead of blindly written." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
</StackPanel></Border>
<Grid Grid.Column="1" Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="UndOpti" Foreground="White" FontSize="32" FontWeight="Bold"/><TextBlock Text="Optimize • Measure • Restore" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="READY" Foreground="#6EE7A8" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,22,0,18">
<Border Style="{StaticResource Card}"><TextBlock x:Name="CpuText" Text="CPU —" Foreground="White" FontSize="22" FontWeight="Bold"/></Border>
<Border Style="{StaticResource Card}"><TextBlock x:Name="RamText" Text="RAM —" Foreground="White" FontSize="22" FontWeight="Bold"/></Border>
<Border Style="{StaticResource Card}"><TextBlock x:Name="GpuText" Text="GPU —" Foreground="White" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/></Border>
<Border Style="{StaticResource Card}"><TextBlock x:Name="RustText" Text="RUST —" Foreground="White" FontSize="22" FontWeight="Bold"/></Border>
<Border Style="{StaticResource Card}"><TextBlock x:Name="ChangesText" Text="CHANGES 0" Foreground="White" FontSize="22" FontWeight="Bold"/></Border>
</UniformGrid>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Performance Center" Foreground="White" FontSize="25" FontWeight="Bold"/>
<TextBlock Text="Safe system optimization, Rust tuning, cleanup, network diagnostics, hardware analysis and restore." Style="{StaticResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap"/>
<StackPanel Orientation="Horizontal"><Button Content="⚡ OPTIMIZE ALL" Click="OptimizeAll_Click" Style="{StaticResource AccentButton}"/><Button Content="↩ RESTORE" Click="Restore_Click"/><Button Content="↻ REFRESH" Click="Refresh_Click"/></StackPanel>
<Separator Margin="0,12"/>
<TextBlock Text="Quick Actions" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,10,0,6"/>
<WrapPanel><Button Content="Windows Optimization" Click="Windows_Click"/><Button Content="Rust Profile" Click="Rust_Click"/><Button Content="Clean Temp" Click="Cleaner_Click"/><Button Content="Flush DNS" Click="Network_Click"/><Button Content="High Performance Power" Click="Power_Click"/><Button Content="Hardware Scan" Click="Hardware_Click"/></WrapPanel>
<TextBlock Text="Hardware / OC Advisor" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,18,0,6"/>
<TextBox x:Name="HardwareReport" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0A0E15" Foreground="#C8D2E3" BorderThickness="0" Padding="12"/>
<TextBlock Text="Activity" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,18,0,6"/>
<TextBlock x:Name="OperationStatus" Text="Ready. No license or key is required." Foreground="#AEB7C8" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Border></Grid></Grid></Grid>
</Window>