<Window x:Class="RustPerformanceSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UndOpti — PC Performance Suite" Width="1400" Height="900" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#090C12">
<Window.Resources>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111722"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="5"/></Style>
<Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="40"/><Setter Property="Background" Value="#1A2230"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2D7DFF"/><Setter Property="FontWeight" Value="Bold"/></Style>
</Window.Resources>
<Grid Margin="15"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0F141D" CornerRadius="14" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="UNDOPTI" Foreground="White" FontSize="25" FontWeight="Bold" Margin="4,4,4,2"/><TextBlock Text="PC PERFORMANCE SUITE" Foreground="#8D98AA" FontSize="11" Margin="4,0,4,18"/>
<Button x:Name="OptimizeAllButton" Content="⚡ OPTIMIZE ALL" Style="{StaticResource AccentButton}"/><Button x:Name="RustButton" Content="🎮 Rust Optimizer"/><Button x:Name="CleanerButton" Content="🧹 Cleaner"/><Button x:Name="NetworkButton" Content="🌐 Network"/><Button x:Name="PowerButton" Content="⚙ High Performance"/><Button x:Name="HardwareButton" Content="🔧 Hardware / BIOS"/><Button x:Name="RefreshButton" Content="↻ Refresh"/>
<Separator Margin="4,12"/><TextBlock Text="TOOLS" Foreground="#4D92FF" FontWeight="Bold" Margin="4,3,4,5"/><Button x:Name="RustPriorityButton" Content="Rust Priority"/><Button x:Name="NetworkTestButton" Content="Network Test"/><Button x:Name="ShaderButton" Content="Shader Cache"/><Button x:Name="StartupButton" Content="Startup Report"/><Button x:Name="RestorePowerButton" Content="Restore Power"/><Button x:Name="RestoreButton" Content="↩ Restore All"/>
<TextBlock Text="SAFE MODE" Foreground="#6EE7A8" FontWeight="Bold" Margin="4,16,4,4"/><TextBlock Text="Only reversible Windows settings are automated. BIOS flashing, blind voltage/clock writes, security disabling and Rust/EAC modification are never automated." Foreground="#8D98AA" FontSize="12" TextWrapping="Wrap" Margin="4"/>
</StackPanel></ScrollViewer></Border>
<Grid Grid.Column="1" Margin="15,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock Text="UndOpti" Foreground="White" FontSize="31" FontWeight="Bold"/><TextBlock Text="Optimize • Measure • Restore" Foreground="#8D98AA"/></StackPanel><TextBlock x:Name="StatusText" Text="READY" DockPanel.Dock="Right" Foreground="#6EE7A8" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="5" Margin="0,14"><Border Style="{StaticResource Card}"><TextBlock x:Name="CpuText" Text="CPU —" Foreground="White" FontSize="19" FontWeight="Bold"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="RamText" Text="RAM —" Foreground="White" FontSize="19" FontWeight="Bold"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="GpuText" Text="GPU —" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="RustText" Text="RUST —" Foreground="White" FontSize="19" FontWeight="Bold"/></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="ChangesText" Text="CHANGES 0" Foreground="White" FontSize="19" FontWeight="Bold"/></Border></UniformGrid>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Performance Center" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="Real system actions, diagnostics and reversible restore." Foreground="#8D98AA" Margin="0,3,0,10"/><WrapPanel><Button x:Name="CenterOptimizeButton" Content="OPTIMIZE ALL" Style="{StaticResource AccentButton}"/><Button x:Name="CenterRestoreButton" Content="RESTORE"/><Button x:Name="CenterRefreshButton" Content="REFRESH"/></WrapPanel>
<TextBlock Text="Hardware / BIOS Advisor" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,12,0,5"/><TextBox x:Name="HardwareReport" Height="170" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0A0E15" Foreground="#C8D2E3" BorderThickness="0" Padding="10"/>
<TextBlock Text="Recommendations" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,12,0,5"/><TextBox x:Name="RecommendationsText" Height="105" IsReadOnly="True" TextWrapping="Wrap" Background="#0A0E15" Foreground="#C8D2E3" BorderThickness="0" Padding="10"/>
<TextBlock Text="Diagnostics" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,12,0,5"/><TextBox x:Name="DiagnosticsText" Height="145" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0A0E15" Foreground="#C8D2E3" BorderThickness="0" Padding="10"/>
<TextBlock Text="Activity" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,12,0,5"/><TextBlock x:Name="OperationStatus" Text="Ready. No license or key is required." Foreground="#AEB7C8" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Border></Grid></Grid>
</Window>